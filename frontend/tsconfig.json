{
  // "extends": "@quasar/app/tsconfig-preset",
  "extends": "../tsconfig.settings.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "esModuleInterop": true,
    "outDir": "build",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "module": "es2020",
    "target": "es2020",
    "moduleResolution": "node",
    "paths": {
      "src/*": ["src/*"],
      "app/*": ["*"],
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "pages/*": ["src/pages/*"],
      "assets/*": ["src/assets/*"],
      "boot/*": ["src/boot/*"],
      "@sinonjs/fake-timers": ["../node_modules/@types/sinonjs__fake-timers"],
      // viem's types import these modules, which this TypeScript version resolves to ox's TypeScript
      // sources instead of its declaration files, so point them at the declaration files.
      "ox/tempo/*": [
        "../node_modules/viem/node_modules/ox/_types/tempo/*",
        "../node_modules/ox/_types/tempo/*"
      ]
    }
  },
  "include": ["src", "test/*", "src/**/*.json", "test/__mocks__/*"],
  "exclude": ["build/*"]
}
